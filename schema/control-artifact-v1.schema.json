{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automat.dev/schema/control-artifact/v1",
  "title": "automat control artifact",
  "description": "A compiled, frozen control set. automat interprets this document at vend time; it never interprets raw upstream catalog formats. Deliberately a strict subset of OSCAL component-definition concepts so upstream suites can adopt it.",
  "type": "object",
  "required": ["schema_version", "artifact", "controls"],
  "additionalProperties": false,

  "properties": {
    "schema_version": {
      "description": "Semantic version of this schema. Consumers must reject major versions they do not know.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "artifact": {
      "type": "object",
      "required": ["id", "title", "sources", "compiled_at", "content_sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/artifact_id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sources": {
          "description": "Provenance of the compile. Every input that influenced controls[] must appear here with a hash.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "compiled_at": {
          "description": "RFC 3339 UTC timestamp, second precision, 'Z' suffix.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },

    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },

  "$defs": {
    "artifact_id": {
      "description": "Stable, lowercase, filesystem- and tag-safe identifier.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },

    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },

    "source": {
      "description": "One compile input. Exactly one of catalog/mapping/artifact names the kind of input.",
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "description": "Authoritative control-text source, e.g. 'FAR 52.204-21'.",
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "description": "Enforcement mapping source, e.g. an AWS Config conformance pack.",
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "description": "An input control artifact, when this artifact is a union (DESIGN 9).",
          "$ref": "#/$defs/artifact_id"
        },
        "version": { "type": "string" },
        "retrieved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "note": {
          "description": "Provenance caveat. Required by ROADMAP Phase 0 where a mapping is partial or absent.",
          "type": "string"
        }
      },
      "oneOf": [
        { "required": ["catalog"] },
        { "required": ["mapping"] },
        { "required": ["artifact"] }
      ]
    },

    "control": {
      "type": "object",
      "required": ["id", "title", "enforcement"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Canonical control identifier in its authoritative numbering.",
          "type": "string",
          "minLength": 1
        },
        "title": { "type": "string", "minLength": 1 },
        "statement": {
          "description": "Verbatim authoritative requirement text.",
          "type": "string"
        },
        "crosswalk": {
          "description": "Equivalent identifiers in other frameworks. This is what lets union dedupe one practice across frameworks (DESIGN 9).",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "enforcement": {
          "description": "How automat enforces or monitors this control. A control may carry several classes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/enforcement_class" }
        },
        "scp": { "$ref": "#/$defs/scp" },
        "config_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/config_rule" }
        },
        "attestation": { "$ref": "#/$defs/attestation" }
      },

      "allOf": [
        {
          "if": { "properties": { "enforcement": { "contains": { "const": "config-rule" } } } },
          "then": { "required": ["config_rules"] }
        },
        {
          "if": { "properties": { "enforcement": { "contains": { "const": "procedural" } } } },
          "then": { "required": ["attestation"] }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "enforcement": { "contains": { "const": "scp" } } } },
              { "properties": { "enforcement": { "contains": { "const": "baseline-protection" } } } }
            ]
          },
          "then": { "required": ["scp"] }
        }
      ]
    },

    "enforcement_class": {
      "description": "scp: preventive, enforced by a service control policy. config-rule: detective, monitored by AWS Config. procedural: requires documented human process; produces an attestation stub. baseline-protection: an SCP that guards automat's own baseline (DESIGN 10).",
      "type": "string",
      "enum": ["scp", "config-rule", "procedural", "baseline-protection"]
    },

    "scp": {
      "description": "Service control policy fragment(s). Deny-style strongly preferred: deny statements concatenate safely under union (DESIGN 9).",
      "type": "object",
      "required": ["statements"],
      "additionalProperties": false,
      "properties": {
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scp_statement" }
        },
        "region_allowlist": {
          "description": "Permitted regions. Intersected under union, never widened.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" }
        },
        "service_allowlist": {
          "description": "Permitted service namespaces. Intersected under union, never widened.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },

    "scp_statement": {
      "type": "object",
      "required": ["sid", "effect", "action"],
      "additionalProperties": false,
      "properties": {
        "sid": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "effect": { "type": "string", "enum": ["Deny", "Allow"] },
        "action": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "not_action": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resource": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "condition": {
          "description": "IAM condition block: operator -> condition key -> value(s).",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "minItems": 1, "items": { "type": "string" } }
              ]
            }
          }
        },
        "exempt_automation_role": {
          "description": "When true, the SCP packer adds a condition exempting automat's in-account automation role, whose ARN is not known until vend time (DESIGN 10).",
          "type": "boolean"
        }
      }
    },

    "config_rule": {
      "type": "object",
      "required": ["identifier"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "description": "AWS Config managed rule source identifier, e.g. IAM_PASSWORD_POLICY.",
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "name": {
          "description": "Config rule name as deployed, e.g. iam-password-policy.",
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/config_rule_parameter" }
        },
        "resource_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "config_rule_parameter": {
      "description": "A rule parameter plus the partial order used to resolve conflicts under union (DESIGN 9).",
      "type": "object",
      "required": ["value", "order"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "order": {
          "description": "min: the smaller value is stricter. max: the larger value is stricter. exact: no ordering; conflicting values are a hard error requiring an explicit override.",
          "type": "string",
          "enum": ["min", "max", "exact"]
        }
      }
    },

    "attestation": {
      "description": "A procedural control's attestation stub.",
      "type": "object",
      "required": ["template", "frequency"],
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "Template filename relative to the artifact's attestation template set.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.md$"
        },
        "frequency": {
          "type": "string",
          "enum": ["annual", "semiannual", "quarterly", "monthly", "on-change", "continuous"]
        },
        "guidance": { "type": "string" }
      }
    }
  }
}
