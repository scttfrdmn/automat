      "id": "AC.L1-b.1.iv",
      "title": "Control public information",
      "statement": "Control information posted or processed on publicly accessible information systems.",
      "crosswalk": {
        "800-171r2": "3.1.22",
        "far": "52.204-21(b)(1)(iv)"
