{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "*"
      ],
      "Condition": {
        "StringLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:root"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "*"
      ],
      "Sid": "Automat67fe9f6858eba533"
    },
    {
      "Action": [
        "config:StopConfigurationRecorder"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::333333333333:role/automat-automation"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "*"
      ],
      "Sid": "Automat335ef53cd62de9c2"
    },
    {
      "Action": [
        "config:DeleteConfigurationRecorder"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::333333333333:role/automat-automation"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "*"
      ],
      "Sid": "Automat4d188839cceef9f6"
    },
    {
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateUser"
      ],
      "Effect": "Deny",
      "Resource": [
        "*"
      ],
      "Sid": "Automat8e34a36915c8ed1f"
    },
    {
      "Action": [
