      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::333333333333:role/automat-automation"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "*"
      ],
      "Sid": "Automat0a8f65dae1cc8a35"
    }
  ]
}
